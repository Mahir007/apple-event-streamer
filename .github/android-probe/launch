#!/system/bin/sh
# The launcher a universal Android archive would ship: one script, both binaries.
d=$(dirname "$(readlink -f "$0")")
case $(uname -m) in
aarch64) a=arm64 ;;
x86_64) a=amd64 ;;
*)
	echo "apple-event-streamer: no build for $(uname -m)" >&2
	exit 1
	;;
esac
exec "$d/lib/apple-event-streamer-$a" "$@"
