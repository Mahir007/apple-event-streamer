BINARY  := apple-event-streamer
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
LDFLAGS := -s -w -X main.version=$(VERSION)
BUILD   := CGO_ENABLED=0 go build -trimpath -tags nethttpomithttp2 -ldflags '$(LDFLAGS)'
# macOS ships as one universal2 (x86_64 + arm64) binary.
TARGETS := linux/amd64 linux/arm64 windows/amd64 windows/arm64 darwin/universal

# Windows executables embed a version resource (tools/winres); Task Manager
# shows its description as the process name. The .syso exists only while
# that one build runs, so a stale version is never linked.
WINRES := go run ./tools/winres -name $(BINARY) -version '$(VERSION)' \
	-description 'Apple Event Streamer' -company Mahir007 -copyright 'Copyright © 2026 Mahir007'

# $(call gobuild,GOOS,GOARCH,OUTPUT)
gobuild = if [ $(1) = windows ]; then $(WINRES) -arch $(2) -o rsrc_windows_$(2).syso || exit 1; fi; \
	GOOS=$(1) GOARCH=$(2) $(BUILD) -o $(3) .; st=$$?; rm -f rsrc_windows_$(2).syso; [ $$st = 0 ]

# Pinned analysis tools, installed into .bin so GOOS/GOARCH below choose
# what is analysed rather than how the tools are built.
STATICCHECK := honnef.co/go/tools/cmd/staticcheck@v0.8.2
GOVULNCHECK := golang.org/x/vuln/cmd/govulncheck@v1.9.0

.PHONY: build dist package test race vet lint clean

build:
	@$(call gobuild,$$(go env GOOS),$$(go env GOARCH),$(BINARY)$$(go env GOEXE))

dist:
	@rm -rf dist && mkdir -p dist/.thin
	@for t in $(TARGETS); do \
		os=$${t%/*}; arch=$${t#*/}; ext=; [ $$os = windows ] && ext=.exe; \
		out=dist/$(BINARY)-$$os-$$arch$$ext; \
		echo "  $$out"; \
		if [ $$arch = universal ]; then \
			GOOS=darwin GOARCH=amd64 $(BUILD) -o dist/.thin/darwin-amd64 . && \
			GOOS=darwin GOARCH=arm64 $(BUILD) -o dist/.thin/darwin-arm64 . && \
			go run ./tools/macuniversal -o $$out dist/.thin/darwin-amd64 dist/.thin/darwin-arm64 || exit 1; \
		else \
			$(call gobuild,$$os,$$arch,$$out) || exit 1; \
		fi; \
	done
	@rm -rf dist/.thin

# Release archives at maximum compression, each holding the binary, LICENSE
# and THIRD_PARTY_LICENSES (notices for all linked modules and the Go
# standard library, generated by tools/thirdparty): .tar.xz (xz -9e) for Linux and macOS, and for Windows a standard
# .zip recompressed with zopfli (advzip -4); each with an <archive>.sha256
# in sha256sum format ("<hash>  <archive>").
# Needs xz, zip and advzip (Debian/Ubuntu: xz-utils zip advancecomp).
# Archives are compressed in parallel; zopfli is single-threaded and slow.
TAR := tar --owner=0 --group=0 --numeric-owner --sort=name

package: dist
	@stage=$$(mktemp -d) && trap 'rm -rf "$$stage"' EXIT && \
	go run ./tools/thirdparty -o "$$stage/THIRD_PARTY_LICENSES" && \
	pids= && for f in dist/$(BINARY)-*; do \
		( set -e; \
		t=$${f#dist/$(BINARY)-}; t=$${t%.exe}; os=$${t%-*}; \
		name=$(BINARY)_$(VERSION)_$$t; ext=; [ $$os = windows ] && ext=.exe; \
		mkdir -m 755 "$$stage/$$name"; \
		install -m 755 $$f "$$stage/$$name/$(BINARY)$$ext"; \
		install -m 644 LICENSE "$$stage/THIRD_PARTY_LICENSES" "$$stage/$$name/"; \
		if [ $$os = windows ]; then \
			(cd "$$stage" && zip -9 -X -q -r $$name.zip $$name && advzip -z -4 -q $$name.zip); \
			mv "$$stage/$$name.zip" dist/; \
		else \
			$(TAR) -C "$$stage" -cf - $$name | xz -9e -T0 > dist/$$name.tar.xz; \
		fi; \
		rm $$f; echo "  dist/$$name" ) & pids="$$pids $$!"; \
	done; \
	fail=0; for p in $$pids; do wait $$p || fail=1; done; [ $$fail = 0 ] && \
	cd dist && for a in *.tar.xz *.zip; do sha256sum $$a > $$a.sha256; done

test:
	go test ./...

# The race detector needs cgo.
race:
	CGO_ENABLED=1 go test -race ./...

vet:
	@for t in linux/amd64 linux/arm64 windows/amd64 windows/arm64 darwin/amd64 darwin/arm64; do \
		GOOS=$${t%/*} GOARCH=$${t#*/} go vet ./... || exit 1; \
	done

# staticcheck and govulncheck per OS: each sees only that OS's files, and
# govulncheck only reports vulnerabilities in code that is reachable there.
lint:
	@GOBIN=$(CURDIR)/.bin go install $(STATICCHECK) && \
	GOBIN=$(CURDIR)/.bin go install $(GOVULNCHECK) && \
	for os in linux windows darwin; do \
		echo "  $$os"; \
		GOOS=$$os GOARCH=amd64 .bin/staticcheck ./... || exit 1; \
		GOOS=$$os GOARCH=amd64 .bin/govulncheck ./... || exit 1; \
	done

clean:
	rm -rf dist .bin $(BINARY) $(BINARY).exe rsrc_windows_*.syso
